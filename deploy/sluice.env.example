# Sluice runtime configuration (the container / binary only).
#
# Source of truth: internal/config/config.go. Defaults below match Load().
# Required variables are left empty — the process refuses to start without them.
#
# Safe to pass to `docker run --env-file`: Docker only treats lines that *start*
# with # as comments; inline # is part of the value. Keep comments on their own
# lines.
#
# This is not the compose harness file. For local bring-up secrets
# (Postgres, GoTrue, JWT material, role passwords) see /.env.example.

# ── server ────────────────────────────────────────────────────────────────
SLUICE_LISTEN_ADDR=0.0.0.0:4000
SLUICE_PATH_PREFIX=/sluice/v1
# debug | info | warn | error
SLUICE_LOG_LEVEL=info
# json | text
SLUICE_LOG_FORMAT=json
# Default: hostname. Prefixes every stream id.
SLUICE_NODE_ID=
# for requests in flight; open streams are ended at once with server_shutdown
SLUICE_SHUTDOWN_GRACE=15s
# clients are told to reconnect at a random point within this window; 0 sends no delay
SLUICE_RECONNECT_SPREAD=10s
# Unset: 90% of the container's memory limit. Set it (e.g. 450MiB) to override.
# GOMEMLIMIT=

# ── database ──────────────────────────────────────────────────────────────
# Repl URL must include replication=database. Authz URL must not.
# required
SLUICE_DB_REPL_URL=
# required
SLUICE_DB_AUTHZ_URL=
# One connection is held permanently for the reader lock.
SLUICE_DB_POOL_MAX_CONNS=8
SLUICE_DB_POOL_MIN_CONNS=2
# DISCARD ALL on every connection returned to the pool
SLUICE_PARANOID_POOL_RESET=false

# ── replication ───────────────────────────────────────────────────────────
SLUICE_SLOT_NAME=sluice
SLUICE_PUBLICATION=sluice
# 1..4; 4 needs PostgreSQL 16+
SLUICE_PROTO_VERSION=4
# deliver pg_logical_emit_message as broadcasts
SLUICE_MESSAGES=true
SLUICE_STATUS_INTERVAL=10s
# must be non-empty; the rest of the message prefix is the channel name
SLUICE_MESSAGE_PREFIX=sluice:

# ── resume buffer ─────────────────────────────────────────────────────────
# changes kept per table
SLUICE_RING_EVENTS=4096
# older entries are swept (a table's newest transaction is always kept)
SLUICE_RING_MAX_AGE=60s

# ── auth ──────────────────────────────────────────────────────────────────
# required — e.g. http://auth:9999/.well-known/jwks.json
SLUICE_JWKS_URL=
SLUICE_JWKS_REFRESH=5m
# ES256 | RS256 — HS256 deliberately rejected
SLUICE_JWT_ALG=ES256
# empty: not checked
SLUICE_JWT_ISSUER=
# checked only for tokens with a sub
SLUICE_JWT_AUDIENCE=authenticated
SLUICE_JWT_LEEWAY=10s
SLUICE_ALLOWED_ROLES=anon,authenticated,service_role

# ── authorization ─────────────────────────────────────────────────────────
# rls (default) | issuer
SLUICE_SHAPE_ORACLE=rls
# required when oracle=issuer
SLUICE_ISSUER_URL=
# required when oracle=issuer; authenticates Sluice to the issuer (not the user JWT)
SLUICE_ISSUER_BEARER=
SLUICE_ISSUER_TIMEOUT=2s
# re-check interval for time-dependent and Tier C predicates
SLUICE_AUTHZ_LEASE=60s
# catalog reload, lease and revocation tick
SLUICE_CATALOG_REFRESH=30s
# allow | deny
SLUICE_TIER_C=allow
SLUICE_TIER_C_MAX_PROBES_PER_SECOND=2000
# per probe and per Tier B cross-check; a probe out of time withholds the change
SLUICE_TIER_C_TIMEOUT=1s
# cross-checks per Tier B subscription; 0 disables
SLUICE_TIER_B_VERIFY=5
SLUICE_UNINDEXED_SHAPES_MAX=200
# warn | strict
SLUICE_REPLICA_IDENTITY=warn
# withhold | deliver — DELETEs no decision could be made about
SLUICE_DEGRADED_DELETES=withhold

# ── snapshots ─────────────────────────────────────────────────────────────
SLUICE_SNAPSHOT_ENABLED=true
SLUICE_SNAPSHOT_MAX_CONCURRENT=4
SLUICE_SNAPSHOT_MAX_ROWS=50000

# ── streams / limits ──────────────────────────────────────────────────────
# must be ≥5s
SLUICE_HEARTBEAT=20s
# most events queued per stream; the queue grows as needed, an idle stream holds none
SLUICE_STREAM_QUEUE=256
SLUICE_WRITE_TIMEOUT=10s
SLUICE_MAX_STREAMS=50000
SLUICE_MAX_SUBS_PER_STREAM=100
SLUICE_MAX_SHAPES_PER_STREAM=20
SLUICE_MAX_PAYLOAD_BYTES=262144
SLUICE_MAX_CHANGE_BYTES=1048576
# per second, per stream
SLUICE_SUBSCRIBE_RATE=20
# per second, per stream
SLUICE_PUBLISH_RATE=100
# per SLUICE_PRESENCE_WINDOW, per stream
SLUICE_PRESENCE_RATE=5
SLUICE_PRESENCE_WINDOW=30s
# diff coalescing tick
SLUICE_PRESENCE_BROADCAST=1500ms
SLUICE_PRESENCE_MAX_KEYS=10

# ── channels ──────────────────────────────────────────────────────────────
# Comma-separated namespace:mode[:hook_url]. Modes: public | owner | hook.
SLUICE_CHANNELS=room:public
SLUICE_CHANNEL_HOOK_TTL=60s
SLUICE_CHANNEL_HOOK_TIMEOUT=2s
# optional; sent as Authorization: Bearer to every hook URL (not the user JWT)
SLUICE_CHANNEL_HOOK_BEARER=

# ── revocation (optional) ─────────────────────────────────────────────────
SLUICE_REVOCATION_ENABLED=false
SLUICE_REVOCATION_SESSIONS_TABLE=auth.sessions
SLUICE_REVOCATION_USERS_TABLE=auth.users

# ── observability ─────────────────────────────────────────────────────────
SLUICE_METRICS_ENABLED=true
SLUICE_DIAGNOSTICS_ENABLED=true
