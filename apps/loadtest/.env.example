# Load-test secrets. These are not production credentials.
# Copy to .env or rely on the compose defaults.

POSTGRES_PASSWORD=loadtest-pg
SLUICE_REPL_PASSWORD=loadtest-repl
SLUICE_AUTHZ_PASSWORD=loadtest-authz
SLUICE_ISSUER_BEARER=loadtest-issuer

# Optional overrides (the runner also reads these).
# LOAD_MAX_STREAMS=0
# LOAD_CHANGES=20
# LOAD_AXIS=all
# LOAD_HUNT=auto
# LOAD_CHANNEL=room:load
# LOAD_SCENARIO=rls-a

# Container limits and core pinning (see README.md and env/).
# SLUICE_CPUS=1
# SLUICE_MEM_LIMIT=512m
# SLUICE_MAX_STREAMS=5000
# SLUICE_CPUSET=2,3
# DB_CPUSET=6-9
# ISSUER_CPUSET=10,11
# PROXY_CPUSET=12,13
# RUNNER_CPUSET=14-19

# Production-shaped profiles (rooms, bigtxn, reconnect, calibrate).
# LOAD_ROOMS=10
# LOAD_ROOM_MEMBERS=80
# LOAD_ROOM_STREAMS=20
# LOAD_TYPING=1
# LOAD_SHAPES=7
# LOAD_DURATION=10m
# LOAD_ARRIVAL=0
# LOAD_REPLICA_IDENTITY=full
# LOAD_ISSUER_LATENCY=5ms-20ms
# LOAD_ISSUER_CONCURRENCY=32
# LOAD_HOOK_TTL=0
