# 0.8.1 as released (both fixes: hold watches unindexed where indexed, and UPDATEs without an old tuple
# cutting nothing), membership holds user first, 10 min each. Image from the fix/hold-routing worktree:
#
#   docker build --build-arg VERSION=0.8.1-rc2 -t sluice:0.8.1-rc2 ../sluice-0.8.1
#   scripts/queue.sh plans/v0.8.1-final.plan results/phase3/raw
#
# LOAD_REPLICA_IDENTITY=pk sets room_members to REPLICA IDENTITY DEFAULT (its primary key, room_id and
# user_id). The rooms profile deletes no member, so any shape_not_authorized there is a false cut.

# 1. The gate before committing 0.8.1: very high with DEFAULT, zero cuts expected.
v081f-veryhigh-default rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=50:80:25:0.3,5:200:50:1 LOAD_DURATION=10m LOAD_ARRIVAL=30s LOAD_REPLICA_IDENTITY=pk SLUICE_IMAGE=sluice:0.8.1-rc2 SLUICE_PULL_POLICY=never LOAD_HOLD_ORDER=user-first

# 2. FULL against DEFAULT: very high at the production limits, the unicorn at 1 CPU with 4 GB.
v081f-veryhigh-full rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=50:80:25:0.3,5:200:50:1 LOAD_DURATION=10m LOAD_ARRIVAL=30s SLUICE_IMAGE=sluice:0.8.1-rc2 SLUICE_PULL_POLICY=never LOAD_HOLD_ORDER=user-first
v081f-unicorn-1cpu-full rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=380:80:28:0.24,16:250:85:1 LOAD_DURATION=10m LOAD_ARRIVAL=2m SLUICE_MAX_STREAMS=15000 SLUICE_MEM_LIMIT=4g SLUICE_IMAGE=sluice:0.8.1-rc2 SLUICE_PULL_POLICY=never LOAD_HOLD_ORDER=user-first
v081f-unicorn-1cpu-default rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=380:80:28:0.24,16:250:85:1 LOAD_DURATION=10m LOAD_ARRIVAL=2m SLUICE_MAX_STREAMS=15000 SLUICE_MEM_LIMIT=4g LOAD_REPLICA_IDENTITY=pk SLUICE_IMAGE=sluice:0.8.1-rc2 SLUICE_PULL_POLICY=never LOAD_HOLD_ORDER=user-first

# 3. Does the unicorn fit in production (1 CPU, 512 MB)? SLUICE_MAX_STREAMS raised so that memory, not the
#    stream cap, answers.
v081f-unicorn-1cpu-512m rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=380:80:28:0.24,16:250:85:1 LOAD_DURATION=10m LOAD_ARRIVAL=2m SLUICE_MAX_STREAMS=15000 SLUICE_MEM_LIMIT=512m SLUICE_IMAGE=sluice:0.8.1-rc2 SLUICE_PULL_POLICY=never LOAD_HOLD_ORDER=user-first

# 4. Idle streams per GB on 0.8.1: phase 2's idle ramp unchanged (3 000 a step up to 15 000, 1 CPU, 4 GB).
v081f-idle-ramp ramp -e env/pin-20cpu.env LOAD_ROOM_MIX=600:80:25:0 LOAD_MSG_EVERY=0 LOAD_TYPING_ENABLED=false LOAD_RAMP_STEP=3000 LOAD_RAMP_HOLD=60s LOAD_RAMP_SETTLE=15s LOAD_RAMP_ARRIVAL=30s SLUICE_MAX_STREAMS=16000 SLUICE_MEM_LIMIT=4g SLUICE_IMAGE=sluice:0.8.1-rc2 SLUICE_PULL_POLICY=never LOAD_HOLD_ORDER=user-first
