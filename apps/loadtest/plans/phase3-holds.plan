# Phase 3, items 2 and 3, 10 min each. Before: the released 0.8.1 (ghcr.io/...:0.8.1, and the v081/v081f runs) and, for item 3, p3-i2.
# sluice:p3-i2 lists each hold under the column with the shortest lists (item 2); sluice:p3-i3 also evaluates
# hold checks without the index lock (item 3). Built from branch phase3 (41e00fc, 4d2ab14), on top of the 0.8.2 fix (/token asks about the requested shape).
#
#   scripts/queue.sh plans/phase3-holds.plan results/phase3/raw

# Item 2: holds written room first, the order 0.8.1 is slow with.
p3-v081-unicorn-1cpu-roomfirst rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=380:80:28:0.24,16:250:85:1 LOAD_DURATION=10m LOAD_ARRIVAL=2m SLUICE_MAX_STREAMS=15000 SLUICE_MEM_LIMIT=4g SLUICE_IMAGE=ghcr.io/pauserratgutierrez/sluice:0.8.1 LOAD_HOLD_ORDER=room-first
p3i2-unicorn-1cpu-roomfirst rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=380:80:28:0.24,16:250:85:1 LOAD_DURATION=10m LOAD_ARRIVAL=2m SLUICE_MAX_STREAMS=15000 SLUICE_MEM_LIMIT=4g SLUICE_IMAGE=sluice:p3-i2 SLUICE_PULL_POLICY=never LOAD_HOLD_ORDER=room-first
p3i2-veryhigh-roomfirst rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=50:80:25:0.3,5:200:50:1 LOAD_DURATION=10m LOAD_ARRIVAL=30s SLUICE_IMAGE=sluice:p3-i2 SLUICE_PULL_POLICY=never LOAD_HOLD_ORDER=room-first
p3i2-veryhigh-userfirst rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=50:80:25:0.3,5:200:50:1 LOAD_DURATION=10m LOAD_ARRIVAL=30s SLUICE_IMAGE=sluice:p3-i2 SLUICE_PULL_POLICY=never LOAD_HOLD_ORDER=user-first

# Item 3: /token under load, tokens every 2 min at the unicorn on 1 CPU, before (p3-i2) and after (p3-i3).
p3i2-unicorn-1cpu-token2m rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=380:80:28:0.24,16:250:85:1 LOAD_DURATION=10m LOAD_ARRIVAL=2m LOAD_TOKEN_EVERY=2m SLUICE_MAX_STREAMS=15000 SLUICE_MEM_LIMIT=4g SLUICE_IMAGE=sluice:p3-i2 SLUICE_PULL_POLICY=never LOAD_HOLD_ORDER=room-first
p3i3-unicorn-1cpu-token2m rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=380:80:28:0.24,16:250:85:1 LOAD_DURATION=10m LOAD_ARRIVAL=2m LOAD_TOKEN_EVERY=2m SLUICE_MAX_STREAMS=15000 SLUICE_MEM_LIMIT=4g SLUICE_IMAGE=sluice:p3-i3 SLUICE_PULL_POLICY=never LOAD_HOLD_ORDER=room-first
