# Phase 2, part 2: the rest of a minimal baseline of Sluice 0.8.0 to compare phase 3 against.
# Run after phase2-tiers.plan:
#
#   scripts/queue.sh plans/phase2-baseline.plan results/phase2/raw
#
# Mixes (count:members:streams:typists per room): high 14:80:25:0.3,1:200:50:1, very high 50:80:25:0.3,5:200:50:1,
# unicorn 380:80:28:0.24,16:250:85:1 (12 000 streams), its scaled-down 5 000-stream version 158:80:28:0.24,7:250:85:1.

# 1. The unicorn with 2 CPUs (a quota of two on four vCPUs: GOMAXPROCS=2), 30 min: does the backlog settle?
unicorn-2cpu rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=380:80:28:0.24,16:250:85:1 LOAD_DURATION=30m LOAD_ARRIVAL=2m SLUICE_MAX_STREAMS=15000 SLUICE_MEM_LIMIT=4g SLUICE_CPUS=2 SLUICE_CPUSET=2-5

# 2. Where the CPU goes: a 60-s CPU profile 4 min into the steady phase, then heap and goroutines, from the
#    same source built with pprof (scripts/build-pprof.sh, image sluice:pprof). 10 min each.
pprof-high rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=14:80:25:0.3,1:200:50:1 LOAD_DURATION=10m LOAD_ARRIVAL=30s SLUICE_IMAGE=sluice:pprof SLUICE_PULL_POLICY=never SLUICE_PPROF_ADDR=0.0.0.0:6060 LOAD_PPROF_AT=4m LOAD_PPROF_SECONDS=60s
pprof-veryhigh rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=50:80:25:0.3,5:200:50:1 LOAD_DURATION=10m LOAD_ARRIVAL=30s SLUICE_IMAGE=sluice:pprof SLUICE_PULL_POLICY=never SLUICE_PPROF_ADDR=0.0.0.0:6060 LOAD_PPROF_AT=4m LOAD_PPROF_SECONDS=60s
pprof-unicorn-1cpu rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=380:80:28:0.24,16:250:85:1 LOAD_DURATION=10m LOAD_ARRIVAL=2m SLUICE_MAX_STREAMS=15000 SLUICE_MEM_LIMIT=4g SLUICE_IMAGE=sluice:pprof SLUICE_PULL_POLICY=never SLUICE_PPROF_ADDR=0.0.0.0:6060 LOAD_PPROF_AT=4m LOAD_PPROF_SECONDS=60s
pprof-unicorn-2cpu rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=380:80:28:0.24,16:250:85:1 LOAD_DURATION=10m LOAD_ARRIVAL=2m SLUICE_MAX_STREAMS=15000 SLUICE_MEM_LIMIT=4g SLUICE_CPUS=2 SLUICE_CPUSET=2-5 SLUICE_IMAGE=sluice:pprof SLUICE_PULL_POLICY=never SLUICE_PPROF_ADDR=0.0.0.0:6060 LOAD_PPROF_AT=4m LOAD_PPROF_SECONDS=60s

# 3. room_members with the primary key's replica identity instead of FULL, at 1 CPU, 10 min each. The FULL
#    runs to compare with are the tiers' main combination.
veryhigh-pk rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=50:80:25:0.3,5:200:50:1 LOAD_DURATION=10m LOAD_ARRIVAL=30s LOAD_REPLICA_IDENTITY=pk
unicorn-pk rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=380:80:28:0.24,16:250:85:1 LOAD_DURATION=10m LOAD_ARRIVAL=2m SLUICE_MAX_STREAMS=15000 SLUICE_MEM_LIMIT=4g LOAD_REPLICA_IDENTITY=pk



# 4. Idle streams (7 shapes and a hook channel; no messages, no typing; tokens and hook re-checks as usual)
#    joining 3 000 a step up to 15 000 at 1 CPU and 4 GB: memory per stream and streams per GB.
idle-ramp ramp -e env/pin-20cpu.env LOAD_ROOM_MIX=600:80:25:0 LOAD_MSG_EVERY=0 LOAD_TYPING_ENABLED=false LOAD_RAMP_STEP=3000 LOAD_RAMP_HOLD=60s LOAD_RAMP_SETTLE=15s LOAD_RAMP_ARRIVAL=30s SLUICE_MAX_STREAMS=16000 SLUICE_MEM_LIMIT=4g

# 5. Big transactions (1 500, 10 000 and 100 000 notification rows, three of each) while the high tier runs.
bigtxn-high bigtxn -e env/pin-20cpu.env LOAD_ROOM_MIX=14:80:25:0.3,1:200:50:1 LOAD_ARRIVAL=30s LOAD_BIGTXN_ROWS=1500,10000,100000 LOAD_BIGTXN_REPEAT=3 LOAD_BIGTXN_EVERY=2m LOAD_BIGTXN_AFTER=1m

# Replaces veryhigh-main-r3, which overlapped work on the host (results/phase2/notes.md).
veryhigh-main-r4 rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=50:80:25:0.3,5:200:50:1 LOAD_DURATION=30m LOAD_ARRIVAL=30s
