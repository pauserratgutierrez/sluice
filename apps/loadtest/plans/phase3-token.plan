# Phase 3, item 1: is anything retained per POST /token? The unicorn at 1 CPU on the released 0.8.1 with
# tokens renewed every 2 min (about 5 cycles in 10 min, ~6 000 renewals a minute), live heap after each GC
# from go_memstats_next_gc_bytes / 2.
#
#   scripts/queue.sh plans/phase3-token.plan results/phase3/raw

p3-token-unicorn-1cpu rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=380:80:28:0.24,16:250:85:1 LOAD_DURATION=10m LOAD_ARRIVAL=2m LOAD_TOKEN_EVERY=2m SLUICE_MAX_STREAMS=15000 SLUICE_MEM_LIMIT=4g SLUICE_IMAGE=ghcr.io/pauserratgutierrez/sluice:0.8.1 LOAD_HOLD_ORDER=user-first

# The same with the released 0.8.1 built with pprof (v0.8.1 plus cmd/sluice/pprof.go, image sluice:0.8.1-pprof),
# heap profiles at 1, 4, 7 and 9.5 min of the steady phase, to see what the live heap gains between them.
p3-token-unicorn-1cpu-pprof rooms -e env/pin-20cpu.env LOAD_ROOM_MIX=380:80:28:0.24,16:250:85:1 LOAD_DURATION=10m LOAD_ARRIVAL=2m LOAD_TOKEN_EVERY=2m SLUICE_MAX_STREAMS=15000 SLUICE_MEM_LIMIT=4g SLUICE_IMAGE=sluice:0.8.1-pprof SLUICE_PULL_POLICY=never SLUICE_PPROF_ADDR=0.0.0.0:6060 LOAD_PPROF_AT=9m40s LOAD_PPROF_SECONDS=10s LOAD_PPROF_HEAP_AT=1m,4m,7m,9m30s LOAD_HOLD_ORDER=user-first
