# Sluice test harness configuration.
#
# Copy to .env and fill in. Generate the secrets and the ES256 signing key with:
#
#   sh deploy/keygen.sh
#
# That prints ready-to-paste lines for JWT_SECRET, JWT_KEYS and JWT_JWKS plus
# every password below. It runs in a container, so no local Go toolchain is
# needed.

# ── general ────────────────────────────────────────────────────────────────
GATEWAY_PORT=8000
PUBLIC_API_URL=http://localhost:8000
APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGIN=*

# ── postgres ───────────────────────────────────────────────────────────────
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ── role passwords ─────────────────────────────────────────────────────────
# sluice_repl carries the REPLICATION attribute. PostgreSQL's own docs call
# that "a very highly privileged role": it can read every column of every
# published table regardless of RLS or grants. Treat this password like a
# superuser password, and never reuse it.
SLUICE_REPL_PASSWORD=

# sluice_authz is LOGIN NOINHERIT and only assumes anon/authenticated inside a
# transaction. Much lower value, but still a real credential.
SLUICE_AUTHZ_PASSWORD=

AUTH_DB_PASSWORD=
PGRST_AUTH_PASSWORD=

# ── JWT ────────────────────────────────────────────────────────────────────
# JWT_KEYS  : private JWK set, ES256/P-256. GoTrue signs with this.
# JWT_JWKS  : public JWK set. PostgREST verifies with this; Sluice fetches the
#             equivalent live from /auth/v1/.well-known/jwks.json.
# JWT_SECRET: GoTrue's refresh-token secret. Sluice never uses it.
#
# Sluice pins alg=ES256 and rejects anything else, so that a `kid` pointing at
# a symmetric key can never turn a public JWKS into a signing oracle.
JWT_SECRET=
JWT_KEYS=
JWT_JWKS=
JWT_EXP=3600

# Long-lived, ES256-signed API keys. These carry only {role, iss, iat, exp} --
# no `sub` and no `session_id` -- so they are useful for service-to-service calls
# and for reading /diagnostics, but they cannot be revoked by signing out.
ANON_KEY=
SERVICE_ROLE_KEY=

# ── log levels ─────────────────────────────────────────────────────────────
SLUICE_LOG_LEVEL=info
SLUICE_LOG_FORMAT=text
GOTRUE_LOG_LEVEL=warn
PGRST_LOG_LEVEL=warn
CADDY_LOG_LEVEL=INFO
